# AI Filmmaking Studio — Environment Variables
# Copy this file to .env.local and fill in values

# Site URL (no trailing slash). Used for canonical URLs, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=https://aifilmmakingstudio.site

# Lemon Squeezy checkout URL for the course product.
# Get this from your Lemon Squeezy dashboard → Products → Share.
NEXT_PUBLIC_LS_CHECKOUT_URL=

# Hosted email newsletter form action URL (e.g. ConvertKit, Beehiiv, Mailchimp, Loops, Formspree).
# Leave blank to render the fallback newsletter signup placeholder.
NEXT_PUBLIC_EMAIL_FORM_ACTION=
